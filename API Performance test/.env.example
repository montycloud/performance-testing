# No secrets are required by the performance test itself.
# Signin uses Email + "New Password" from the users CSV — no .env needed.
#
# If future test steps require a captcha bypass token, uncomment and fill in:
# CAPTCHA_CODE=dummy-token-for-debug

# Day2SDK API performance test (day2sdk_api/day2sdk_locustfile.py) authenticates
# with static AccessKey/SecretKey pairs instead of the users CSV. Add one
# numbered pair per simulated user (round-robin assigned); never commit real
# values — this file is .env.example only.
# DAY2SDK_ACCESS_KEY_1=
# DAY2SDK_SECRET_KEY_1=
# DAY2SDK_ACCESS_KEY_2=
# DAY2SDK_SECRET_KEY_2=
