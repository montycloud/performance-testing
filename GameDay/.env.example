# =============================================================================
# GameDay User Creation — Secret Tokens
#
# Copy this file to .env and set the token value before running.
#   cp .env.example .env
#
# All other configuration (BASE_URL, workers, CSV path, etc.) lives in
# config.yaml — edit that file instead.
#
# .env is git-ignored — never commit secrets to source control.
# =============================================================================

# Captcha bypass token sent in signup and password-reset API calls.
# Use "dummy-token-for-debug" for dev/debug environments only.
CAPTCHA_CODE=dummy-token-for-debug
